{
  "name": "stockroom-application",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "demo:reset": "node scripts/setup.mjs --reset --confirm-reset",
    "postinstall": "node scripts/prepare-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:product": "node scripts/demo-product.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
